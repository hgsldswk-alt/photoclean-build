    },
    "照片与分析结果只在本机处理，不收集数据，不使用分析服务，不上传照片。浏览 iCloud 照片由系统下载预览；购买由 App Store 处理。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片与分析结果只在本机处理，不收集数据，不使用分析服务，不上传照片。浏览 iCloud 照片由系统下载预览；购买由 App Store 处理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos and analysis stay on this device. We collect no data, use no analytics and upload no photos. The system downloads iCloud previews; the App Store handles purchases."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片與分析結果只在本機處理，不蒐集資料、不使用分析服務、不上傳照片。瀏覽 iCloud 照片由系統下載預覽；購買由 App Store 處理。"
          }
        }
      }
    },
