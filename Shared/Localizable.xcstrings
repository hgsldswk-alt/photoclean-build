    "iCloud 照片会从所有同步设备删除。删除后 30 天内，可从「最近删除」恢复。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 照片会从所有同步设备删除。删除后 30 天内，可从「最近删除」恢复。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud photos will be deleted from all synced devices. You can recover them from Recently Deleted for 30 days."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 照片會從所有同步裝置刪除。刪除後 30 天內，可從「最近刪除」復原。"
          }
        }
      }
    },
