{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相册清理"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo Cleaner"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相簿清理"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用来在手机上找出相似照片、截图和大视频，帮你整理和删除。照片只在本机处理，不会上传。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to find similar photos, screenshots and large videos so you can review and delete them. Everything stays on this iPhone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用來在手機上找出相似照片、截圖和大影片，幫你整理和刪除。照片只在本機處理，不會上傳。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
